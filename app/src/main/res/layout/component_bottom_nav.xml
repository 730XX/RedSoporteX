<com.google.android.material.bottomnavigation.BottomNavigationView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    app:backgroundTint="@color/surface_card"
    app:elevation="4dp"
    app:paddingBottomSystemWindowInsets="false"
    app:paddingTopSystemWindowInsets="false"
    app:itemActiveIndicatorStyle="@style/Widget.RedSoporte.NavigationIndicator"
    app:itemIconTint="@color/nav_icon"
    app:itemTextColor="@color/nav_icon"
    app:labelVisibilityMode="labeled"
    app:menu="@menu/main_bottom_menu" />
